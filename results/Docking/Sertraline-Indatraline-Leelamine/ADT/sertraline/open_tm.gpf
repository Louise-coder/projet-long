npts 126 126 126                     # num.grid points in xyz
gridfld centroid1_all_atom.maps.fld  # grid_data_file
spacing 0.826666666667               # spacing(A)
receptor_types A C HD N NA OA SA     # receptor atom types
ligand_types A C N HD Cl             # ligand atom types
receptor centroid1_all_atom.pdbqt    # macromolecule
gridcenter 44.695 55.169 91.546      # xyz-coordinates or auto
smooth 0.5                           # store minimum energy w/in rad(A)
map centroid1_all_atom.A.map         # atom-specific affinity map
map centroid1_all_atom.C.map         # atom-specific affinity map
map centroid1_all_atom.N.map         # atom-specific affinity map
map centroid1_all_atom.HD.map        # atom-specific affinity map
map centroid1_all_atom.Cl.map        # atom-specific affinity map
elecmap centroid1_all_atom.e.map     # electrostatic potential map
dsolvmap centroid1_all_atom.d.map              # desolvation potential map
dielectric -0.1465                   # <0, AD4 distance-dep.diel;>0, constant
